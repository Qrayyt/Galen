<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Galen-Setup-x64</AssemblyName>
    <RootNamespace>GalenInstaller</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\..\..\assets\galen-brand\icon.ico</ApplicationIcon>
    <Version Condition="'$(Version)' == ''">0.0.0.0</Version>
    <Product>Galen</Product>
    <Company>Galenite</Company>
    <Description>Galen Setup</Description>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\..\assets\galen-brand\mark-dark.png" Link="Brand\galen.png" />
  </ItemGroup>
</Project>
