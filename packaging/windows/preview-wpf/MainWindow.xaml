<Window x:Class="GalenInstaller.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Установка Galen" Width="620" Height="448" MinWidth="620" MinHeight="448"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
 Background="#141414" FontFamily="Segoe UI" UseLayoutRounding="True"
 SnapsToDevicePixels="True" KeyDown="OnKeyDown" Loaded="OnLoaded">
 <Window.Resources>
  <Style x:Key="Primary" TargetType="Button">
   <Setter Property="Foreground" Value="#151515"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="#F5F5F5"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DEDEDE"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#C5C5C5"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#909090"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="CloseStyle" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#A6A6A6"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#303030"/><Setter Property="Foreground" Value="White"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#414141"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="Root" Background="#141414" BorderBrush="#353535" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragHeader">
    <TextBlock Text="Galen" Margin="22,0,0,0" VerticalAlignment="Center" Foreground="#B6B6B6" FontSize="13" FontWeight="SemiBold"/>
    <Button Style="{StaticResource CloseStyle}" Width="32" Height="30" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseClick" ToolTip="Закрыть" AutomationProperties.Name="Закрыть">
     <Path Data="M 2,2 L 12,12 M 12,2 L 2,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    </Button>
   </Grid>
   <Grid Grid.Row="1" Margin="44,0,44,0">
    <Grid.RowDefinitions><RowDefinition Height="132"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Width="176" Height="132" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Ellipse x:Name="Glow" Width="176" Height="132" Opacity="0.72" IsHitTestVisible="False">
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#29FFFFFF" Offset="0"/><GradientStop Color="#0BFFFFFF" Offset="0.48"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
     </Ellipse>
     <Image x:Name="Logo" Source="Brand/galen.png" Width="85" Height="92" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
      <Image.RenderTransform><ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/></Image.RenderTransform>
     </Image>
    </Grid>
    <Grid Grid.Row="1" x:Name="Stage" Margin="0,4,0,0" RenderTransformOrigin="0.5,0.5">
     <Grid.RenderTransform><TranslateTransform x:Name="StageMove"/></Grid.RenderTransform>
     <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="Heading" Grid.Row="0" Text="Установка Galen" FontSize="30" FontWeight="SemiBold" Foreground="#F7F7F7" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
     <TextBlock x:Name="Description" Grid.Row="1" Text="Ваш персональный AI-ассистент.&#x0a;Всё готово к установке." Foreground="#A7A7A7" FontSize="14" LineHeight="22" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" TextWrapping="Wrap" MaxWidth="480"/>
     <Grid Grid.Row="2" VerticalAlignment="Top" Margin="0,12,0,0">
      <Button x:Name="PrimaryButton" Style="{StaticResource Primary}" Content="Установить" Width="188" Height="44" HorizontalAlignment="Center" VerticalAlignment="Top" Click="PrimaryClick" IsDefault="True"/>
      <Grid x:Name="ProgressArea" Visibility="Collapsed" Width="378" HorizontalAlignment="Center" VerticalAlignment="Top">
       <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="7"/><RowDefinition Height="24"/></Grid.RowDefinitions>
       <TextBlock x:Name="Status" Text="Подготовка компонентов" FontSize="12" Foreground="#B5B5B5" VerticalAlignment="Top"/>
       <TextBlock x:Name="Percent" Text="0%" FontSize="12" Foreground="#DCDCDC" HorizontalAlignment="Right" VerticalAlignment="Top"/>
       <Border Grid.Row="1" CornerRadius="3.5" Background="#343434" ClipToBounds="True">
        <Border Background="#F0F0F0" CornerRadius="3.5" RenderTransformOrigin="0,0.5">
         <Border.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1"/></Border.RenderTransform>
        </Border>
       </Border>
       <TextBlock Grid.Row="2" Text="Демонстрация установки" Foreground="#777777" FontSize="11" Margin="0,6,0,0"/>
      </Grid>
     </Grid>
    </Grid>
   </Grid>
   <Grid Grid.Row="2" Margin="22,0,22,0">
    <TextBlock Text="GALENITE" Foreground="#777777" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text="Визуальный прототип · V3" Foreground="#777777" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
  </Grid>
 </Border>
</Window>
